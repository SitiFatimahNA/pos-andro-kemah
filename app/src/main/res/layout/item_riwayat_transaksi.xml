<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    tools:context=".item_riwayat_transaksi">

    <!-- Avatar Icon -->
    <androidx.cardview.widget.CardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_page"
        android:layout_marginEnd="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_transaction"
            app:tint="@color/accent_gold" />
    </androidx.cardview.widget.CardView>

    <!-- Konten Tengah -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <!-- Nomor Transaksi -->
        <TextView
            android:id="@+id/tvNomorRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRX-20260601-0001"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <!-- Nama Pelanggan -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_customer"
                app:tint="@color/text_hint"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvPelangganRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shofi"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tanggal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_quick_item"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tvTanggalRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-01 19:28:04"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kanan: Total + Metode -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvLabelTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL"
            android:textColor="@color/text_hint"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvTotalRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 16.000"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Badge Metode Pembayaran -->
        <TextView
            android:id="@+id/tvMetodeRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tunai"
            android:textColor="@color/accent_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_metode"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

</LinearLayout>